# ── Polymarket ────────────────────────────────────────────────────────────────
# Export from: Polymarket.com → Cash → ⋯ → Export Private Key
POLY_PRIVATE_KEY=0x...

# Run: python main.py --mode derive-key  to generate these
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# 137 = Polygon mainnet (do not change)
POLY_CHAIN_ID=137

# ── AI ────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Telegram ──────────────────────────────────────────────────────────────────
# Create a bot at https://t.me/BotFather to get the token
TELEGRAM_BOT_TOKEN=
# Your personal chat ID — send /start to @userinfobot to find it
TELEGRAM_CHAT_ID=

# ── Trading guardrails ────────────────────────────────────────────────────────
MAX_POSITION_USDC=50         # Max USDC per single trade
MAX_OPEN_POSITIONS=5         # Max concurrent open positions
MAX_DAILY_SPEND_USDC=200     # Hard daily kill-switch (halts all trading when hit)
MIN_CONFIDENCE_SCORE=7       # Claude must score >= this (1-10) to execute a trade

# ── Monitoring ────────────────────────────────────────────────────────────────
POLL_INTERVAL_SECONDS=60     # How often to poll markets (polling mode)
USE_WEBSOCKET=false          # Set to true for real-time WebSocket monitoring
SIGNIFICANT_MOVE_PCT=5.0     # Price change % that triggers an alert
MIN_MARKET_LIQUIDITY=1000.0  # Min USDC liquidity to consider a market
